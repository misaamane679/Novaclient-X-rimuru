{
  "schemaVersion": 1,
  "id": "nova",
  "version": "${version}",
  "name": "Nova Client",
  "description": "A lightweight, touch-friendly Fabric client-side HUD and settings mod for Minecraft 1.20.1.",
  "authors": ["Nova Team"],
  "environment": "client",
  "entrypoints": {
    "client": ["dev.nova.client.NovaClient"]
  },
  "mixins": ["nova.mixins.json"],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": "*"
  }
}
